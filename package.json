{
  "name": "finway",
  "productName": "Finway",
  "version": "0.8.1",
  "description": "Finway — registro de gastos e ingresos con análisis de balances.",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Finway.git"
  },
  "homepage": "https://github.com/kiddshady/Finway",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/dominio-format.test.mjs && node test/movimientos.test.mjs && node test/plan.test.mjs",
    "smoke": "electron test/renderer.test.cjs",
    "icons": "electron tools/iconos.mjs",
    "dist": "electron-builder --win",
    "check-dist": "node tools/verificar-paquete.mjs",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kiddshady.finway",
    "productName": "Finway",
    "copyright": "© 2026 Kidd Shady · Umbrovex Systems",
    "publish": [
      {
        "provider": "github",
        "owner": "kiddshady",
        "repo": "Finway"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "assets/icon.ico",
      "assets/icon_16.png",
      "assets/icon_24.png",
      "assets/icon_32.png",
      "!data/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Finway"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
